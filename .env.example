# Base Postgres du client (Neon, place de marché Vercel, région Francfort). Posée par l'intégration Neon.
DATABASE_URL=
# Mot de passe d'accès au tableau de bord. Sans lui, le site est ouvert.
DASHBOARD_PASSWORD=
# Secret des webhooks entrants (Brevo, ReachMCP, formulaire) et sel de l'empreinte des adresses IP.
WEBHOOK_SECRET=
# Jeton IPinfo Lite (gratuit, compte à créer sur ipinfo.io). Sans lui, l'API publique limitée est utilisée.
IPINFO_TOKEN=
# Domaines autorisés à envoyer des visites (séparés par des virgules).
SITES_SUIVIS=hirondo.co,www.hirondo.co
